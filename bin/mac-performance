#!/usr/bin/env bash
set -e

hyprctl eval '
hl.config({
    general = {
        gaps_in = 2,
        gaps_out = 4,
        border_size = 1,
    },

    decoration = {
        rounding = 6,
        active_opacity = 1.0,
        inactive_opacity = 1.0,

        blur = {
            enabled = false,
        },

        shadow = {
            enabled = false,
        },
    },

    animations = {
        enabled = false,
    },
})
'

powerprofilesctl set balanced

printf '%s\n' performance > "${XDG_RUNTIME_DIR:-/tmp}/archmac-mode"

# Keep Galaxy ModeService synchronized with legacy keybind execution.
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/archmac"
printf '%s\n' "performance" > "${XDG_STATE_HOME:-$HOME/.local/state}/archmac/mode"

# Galaxy transient mode event.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/archmac"
mkdir -p "$STATE_DIR"
printf '%s\n' "performance $(date +%s%N)" > "$STATE_DIR/mode-event"
