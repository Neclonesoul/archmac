#!/usr/bin/env bash

set -u

SCREENSAVER="$HOME/.local/bin/archmac-screensaver"

# Never stack multiple Galaxy windows.
# Match only the actual screensaver process.
# Do NOT match archmac-screensaver-launch itself.
if pgrep -f '/archmac-screensaver$' >/dev/null 2>&1; then
    exit 0
fi

exec kitty \
    --detach \
    --start-as=fullscreen \
    --class archmac-screensaver \
    --title "ARCHMAC // GALAXY" \
    "$SCREENSAVER"
