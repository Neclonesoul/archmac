<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
    <icon>utilities-terminal</icon>
    <name>Open Terminal Here</name>
    <submenu></submenu>
    <unique-id>archmac-open-terminal</unique-id>
    <command>kitty --directory %f</command>
    <description>Open Kitty in this directory</description>
    <range></range>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
</action>
<action>
    <icon>preferences-desktop-wallpaper</icon>
    <name>Set as ARCHMAC Wallpaper</name>
    <submenu></submenu>
    <unique-id>archmac-set-wallpaper</unique-id>
    <command>archmac-wallpaper %f</command>
    <description>Set selected image as the ARCHMAC wallpaper</description>
    <range></range>
    <patterns>*.png;*.jpg;*.jpeg;*.webp;*.PNG;*.JPG;*.JPEG;*.WEBP</patterns>
    <image-files/>
</action>
</actions>
